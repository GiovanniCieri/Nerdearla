{
  "name": "nerdearla-live-captions",
  "version": "1.0.0",
  "productName": "Nerdearla Live",
  "private": true,
  "main": "desktop/main.cjs",
  "type": "module",
  "description": "Subtítulos y traducción en vivo para conferencias, con Gemini Live API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron desktop/main.cjs",
    "desktop:smoke": "electron desktop/main.cjs --smoke-test",
    "desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop-win.ps1",
    "smoke:gemini-setup": "node scripts/smoke-gemini-setup.mjs",
    "evaluate-quality": "node scripts/evaluate-quality.mjs",
    "test": "node scripts/run-tests.cjs",
    "test:integration": "node scripts/smoke-integration.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  }
}
