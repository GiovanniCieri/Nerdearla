# Creá una API key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
PORT=3000
GEMINI_BILLING_TIER=free
# Stable ID of the bundled Chromium capture extension. Change only for a custom build.
CAPTURE_EXTENSION_ID=hihbplbemkhehapigojnjdhcilndcjeg
# Optional: generate a strong token or let the production container create one in /app/data/operator-token.
# Optional local WhisperLiveKit endpoint, for example ws://localhost:8000/asr.
LOCAL_ASR_WS_URL=
LOCAL_ASR_TOKEN=
LOCAL_SPEAKER_DIARIZATION=false
# Needed only by the optional WhisperLiveKit Sortformer diarization profile, if its model requires access.
HF_TOKEN=
AUTO_FALLBACK_TO_LOCAL=false
MAX_ACTIVE_SESSIONS=30
MAX_AUDIO_QUEUE_CHUNKS=3
MAX_TRANSLATION_REQUESTS=8
# Provisional translation cadence. Drafts are rate limited across all rooms.
DRAFT_TRANSLATION_INTERVAL_MS=1200
DRAFT_TRANSLATIONS_PER_SECOND=4
# Set a positive value to prevent starting cloud sessions after this paid-equivalent daily budget is reached.
DAILY_BUDGET_USD=0
# Set this after billing is enabled on the Gemini project.
GEMINI_LIVE_TRANSLATE_USD_PER_MINUTE=0.0368
GEMINI_TRANSCRIBE_LIVE_USD_PER_MINUTE=0.009
FLASH_LITE_INPUT_USD_PER_MILLION=0.30
FLASH_LITE_OUTPUT_USD_PER_MILLION=2.50
# Set an infrastructure rate to include local inference in the estimate.
LOCAL_ASR_INFRA_USD_PER_MINUTE=0
