{
  "manifest_version": 3,
  "name": "Nerdearla Captura por pestaña",
  "description": "Envía el audio de cada pestaña Chromium a una sesión independiente de Nerdearla Live Captions.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabs", "offscreen", "storage", "tabCapture"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Capturar esta pestaña para Nerdearla",
    "default_popup": "popup.html"
  }
}
